# Postgres local (docker compose)
DATABASE_URL=

# Segredo longo e aleatório para assinar a sessão do backoffice
AUTH_SECRET=

# Login do backoffice. Gere o hash com:
# node -e "console.log(require('bcryptjs').hashSync('sua-senha', 10))"
ADMIN_EMAIL=
# No .env, escape cada $ do hash bcrypt com \ para o carregador não interpretar a variável.
ADMIN_PASSWORD_HASH=

# Canais públicos. O botão de WhatsApp e o e-mail só aparecem quando estas variáveis existem.
# NEXT_PUBLIC_ é lida no build: depois de alterar, gere o site de novo.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP=
